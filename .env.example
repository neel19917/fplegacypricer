# Master Password for App Access
VITE_MASTER_PASSWORD=your-password-here

# Anthropic Claude API Key for Screenshot Parsing (Server-side only)
# Get your API key from: https://console.anthropic.com/
# This key is used by the proxy server (server.js) and is NOT exposed to the browser
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Claude Model Selection (optional, defaults to claude-3-5-sonnet-20240620)
# Available models:
#   - claude-3-5-sonnet-20240620 (default, recommended for best quality)
#   - claude-3-opus-20240229 (highest quality, slower)
#   - claude-3-5-haiku-20241022 (fastest, lower cost)
#   - claude-3-sonnet-20240229 (older version)
CLAUDE_MODEL=claude-3-5-sonnet-20240620

# Optional: Proxy Server URL (defaults to http://localhost:3001)
# Only needed if running proxy server on different port/host
# VITE_PROXY_URL=http://localhost:3001

# Optional: Proxy Server Port (defaults to 3001)
PORT=3001

# Optional: Allowed origin for CORS in production
# ALLOWED_ORIGIN=https://your-production-domain.com

# --- Supabase (app uses VITE_*; script/Netlify can use same or below) ---
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- HubSpot Products sync (scripts/sync-hubspot-products.js + Netlify syncHubSpotProducts) ---
# Create a Private App in HubSpot with scopes: crm.objects.products.read, crm.objects.products.write
# HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# For sync script / Netlify function (optional: service role for RLS bypass)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
